# Required: Revolut Business API access token
REVOLUT_ACCESS_TOKEN=your_revolut_access_token_here

# Optional: Use sandbox URL for testing
# REVOLUT_API_BASE_URL=https://sandbox-b2b.revolut.com/api/1.0

# Database connection (choose one approach):
# Option 1 — single URL (preferred, used by Prisma directly)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/revolutistics

# Option 2 — individual vars (will be assembled into DATABASE_URL automatically)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=revolutistics
# DB_USER=postgres
# DB_PASSWORD=postgres

# Optional: Sync settings
# SYNC_INTERVAL_SECONDS=300
# SYNC_LOOKBACK_DAYS=30

# Optional: Server port (default: 3000)
# PORT=3000
