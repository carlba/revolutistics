# Revolut Open Banking OAuth 2.0 credentials
# Register as an Open Banking TPP to obtain these from Revolut's Developer Portal.
REVOLUT_CLIENT_ID=your_client_id_here
REVOLUT_CLIENT_SECRET=your_client_secret_here

# Access token obtained via the Open Banking authorization code flow.
# If REVOLUT_REFRESH_TOKEN is also set, the service will auto-refresh this token.
REVOLUT_ACCESS_TOKEN=your_access_token_here

# Optional: Refresh token for automatic access token renewal
# REVOLUT_REFRESH_TOKEN=your_refresh_token_here

# Optional: Override the Open Banking base URL (e.g. for sandbox testing)
# REVOLUT_API_BASE_URL=https://sandbox-oba.revolut.com/api
# REVOLUT_TOKEN_URL=https://sandbox-oba.revolut.com/token

# Required: Postgres connection URI
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/revolutistics

# Optional: Sync settings
# SYNC_INTERVAL_SECONDS=300
# SYNC_LOOKBACK_DAYS=30

# Optional: Server port (default: 3000)
# PORT=3000
