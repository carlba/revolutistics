{
  "name": "revolutistics",
  "description": "Retrieve Revolut transactions at configurable intervals and store them in Postgres, with a web UI for browsing.",
  "version": "0.0.1",
  "private": false,
  "license": "UNLICENSED",
  "type": "module",
  "author": "carlba",
  "homepage": "https://github.com/carlba/typescript-template",
  "bugs": {
    "url": "https://github.com/carlba/typescript-template"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:carlba/typescript-template"
  },
  "scripts": {
    "build": "prisma generate && tsc && cp -r src/public dist/public",
    "start": "prisma db push && node dist/index.js",
    "start:dev": "prisma db push && nodemon -r dotenv/config -q src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dependency:update": "npx ncu -u -x eslint"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.3",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "nodemon": "^3.1.11",
    "npm-check-updates": "^19.3.1",
    "prettier": "^3.7.4",
    "prisma": "^6.19.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "got": "^14.6.6"
  }
}
